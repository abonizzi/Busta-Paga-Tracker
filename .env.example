# Chiave API Google Gemini (server-side, mai esposta al browser) - OBBLIGATORIA
# Si ottiene gratis su https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chiave API Resend, per inviare le segnalazioni scritte nelle Impostazioni
# (server-side, mai esposta al browser) - OBBLIGATORIA per la sezione
# Segnalazioni. Gratuita su https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Le due variabili qui sotto sono OPZIONALI ---
# Servono solo se vuoi che l'app sia già collegata al tuo Supabase al primo
# avvio, senza dover passare dalla schermata Impostazioni. Se le lasci
# vuote, potrai comunque collegare Supabase in qualsiasi momento inserendo
# URL e chiave anon direttamente nell'app (Impostazioni > Sincronizzazione),
# ed è quello il modo consigliato per sincronizzare più dispositivi.

# URL del progetto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave pubblica anon (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
